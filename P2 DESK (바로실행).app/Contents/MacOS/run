#!/bin/bash
#
# P2 DESK 바로실행기 (macOS)
#
# 파인더에서 더블클릭하면 이 파일이 직접 실행된다. 터미널을 열지 않으므로
# .zprofile / .zshrc 같은 로그인 셸 설정을 전혀 거치지 않는다.
#
# 인터넷에서 받은 서명 없는 앱은 macOS 가 임시 읽기전용 위치로 옮겨 실행한다
# (App Translocation). 그러면 앱 기준 상대경로로는 프로젝트 폴더를 찾을 수 없다.
# 그래서 못 찾으면 사용자에게 한 번 물어보고, 그 답을 기억해 둔다.
#
set -u

HERE="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)" || HERE=""
SETTINGS_DIR="$HOME/Library/Application Support/P2 DESK"
SAVED_PATH="$SETTINGS_DIR/project-path.txt"

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"P2 DESK\"" >/dev/null 2>&1
}

looks_like_project() {
  [ -n "${1:-}" ] && [ -f "$1/package.json" ] && [ -d "$1/app" ] && [ -f "$1/electron/main.js" ]
}

# 프로젝트 폴더 찾기: 앱 옆 → 지난번에 고른 곳 → 직접 고르기
resolve_project() {
  if looks_like_project "$HERE"; then echo "$HERE"; return 0; fi

  if [ -f "$SAVED_PATH" ]; then
    local saved
    saved="$(/bin/cat "$SAVED_PATH" 2>/dev/null)"
    if looks_like_project "$saved"; then echo "$saved"; return 0; fi
  fi

  local picked
  picked="$(/usr/bin/osascript <<'APPLESCRIPT' 2>/dev/null
display dialog "앱이 놓인 위치를 확인하지 못했습니다.

macOS 가 보안상 앱을 임시 위치에서 실행했기 때문입니다. 흔한 일이니 걱정하지 않으셔도 됩니다.

다음 창에서 압축을 푼 P2 DESK 폴더를 골라 주세요. 한 번만 고르면 다음부터는 묻지 않습니다." buttons {"폴더 고르기"} default button 1 with title "P2 DESK"
POSIX path of (choose folder with prompt "압축을 푼 P2 DESK 폴더를 선택해 주세요")
APPLESCRIPT
)"
  picked="${picked%/}"
  if looks_like_project "$picked"; then
    /bin/mkdir -p "$SETTINGS_DIR"
    /bin/echo "$picked" > "$SAVED_PATH"
    echo "$picked"
    return 0
  fi
  return 1
}

PROJECT="$(resolve_project || true)"
if [ -z "${PROJECT:-}" ]; then
  /usr/bin/osascript -e 'display dialog "P2 DESK 폴더를 찾지 못했습니다.

압축을 푼 폴더(안에 app 폴더와 package.json 이 들어 있는 곳)를 골라 주세요." buttons {"확인"} default button 1 with title "P2 DESK" with icon caution' >/dev/null 2>&1
  exit 1
fi

cd "$PROJECT" || exit 1
LOG="$PROJECT/설치기록.txt"

# 실패 내용을 파일로 찾아 헤매지 않도록, 마지막 부분을 창에 그대로 보여준다
show_failure() {
  /usr/bin/osascript <<APPLESCRIPT >/dev/null 2>&1
set logTail to ""
try
  set logTail to (do shell script "tail -n 12 " & quoted form of "$LOG")
end try
set msg to "필요한 파일을 내려받지 못했습니다." & return & return & ¬
  "폴더: $PROJECT" & return & return & ¬
  "아래 내용을 캡처해서 보내주세요." & return & return & logTail
display dialog msg buttons {"폴더 열기", "확인"} default button 2 with title "P2 DESK" with icon caution
if button returned of result is "폴더 열기" then
  do shell script "open " & quoted form of "$PROJECT"
end if
APPLESCRIPT
}

# 컴퓨터에 이미 들어있는 Electron 을 찾는다.
# 영상 편집용 프로그램 중에는 Electron 을 품고 다니는 것들이 있어서,
# 내려받기가 막힌 환경에서는 그걸 빌려 쓰는 편이 빠르다.
find_local_electron() {
  local known="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Applications/Electron.app/Contents/MacOS/Electron"
  [ -x "$known" ] && { echo "$known"; return 0; }
  local found
  found="$(/usr/bin/find /Applications -maxdepth 6 -type f -name Electron -perm -111 2>/dev/null | /usr/bin/head -1)"
  [ -n "$found" ] && { echo "$found"; return 0; }
  return 1
}

if ! command -v npm >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display dialog "Node.js 가 설치되어 있지 않습니다.

잠시 후 열리는 nodejs.org 에서 왼쪽의 LTS 버튼을 눌러 설치한 뒤, 이 앱을 다시 실행해 주세요." buttons {"확인"} default button 1 with title "P2 DESK" with icon caution' >/dev/null 2>&1
  /usr/bin/open "https://nodejs.org"
  exit 1
fi

# 앱 본체(약 100MB)가 없으면 받아온다. 한 번 받으면 다음부터는 건너뛴다.
if [ ! -d "node_modules/electron/dist" ]; then
  notify "필요한 파일을 내려받는 중입니다. 몇 분 걸립니다."
  : > "$LOG" 2>/dev/null || true
  npm install --foreground-scripts >>"$LOG" 2>&1

  if [ ! -d "node_modules/electron/dist" ]; then
    notify "다른 서버에서 다시 시도합니다."
    printf '\n=== 미러 서버로 재시도 ===\n' >>"$LOG"
    rm -rf node_modules/electron
    ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/" \
      npm install electron --foreground-scripts >>"$LOG" 2>&1
  fi

  # 그래도 안 되면, 이 컴퓨터에 이미 있는 Electron 을 빌려 쓸지 물어본다
  if [ ! -d "node_modules/electron/dist" ]; then
    LOCAL_ELECTRON="$(find_local_electron || true)"
    if [ -n "${LOCAL_ELECTRON:-}" ]; then
      OWNER="$(echo "$LOCAL_ELECTRON" | /usr/bin/awk -F'/' '{print $3}')"
      ANSWER="$(/usr/bin/osascript -e "display dialog \"파일을 내려받지 못했습니다.

대신 이 컴퓨터에 이미 설치된 [$OWNER] 안의 실행 부품을 빌려 쓸 수 있습니다. 내려받기 없이 바로 앱이 열립니다.

빌려 쓸까요?\" buttons {\"아니요\", \"빌려 쓰기\"} default button 2 with title \"P2 DESK\"" 2>/dev/null)"
      if [ "${ANSWER:-}" = "button returned:빌려 쓰기" ]; then
        printf '\n=== 이 컴퓨터의 Electron 사용: %s ===\n' "$LOCAL_ELECTRON" >>"$LOG"
        exec "$LOCAL_ELECTRON" "$PROJECT"
      fi
    fi
    show_failure
    exit 1
  fi
  notify "준비가 끝났습니다. 앱을 엽니다."
fi

exec ./node_modules/.bin/electron .
