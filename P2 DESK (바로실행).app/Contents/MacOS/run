#!/bin/bash
#
# P2 DESK 바로실행기 (macOS)
#
# 파인더에서 더블클릭하면 이 파일이 직접 실행된다. 터미널을 열지 않으므로
# .zprofile / .zshrc 같은 로그인 셸 설정을 전혀 거치지 않는다. 그 설정들이
# 망가져 있어도 앱은 정상적으로 뜬다.
#
set -u

# 이 실행기는 프로젝트 폴더 안에 있다: <프로젝트>/P2 DESK (바로실행).app/Contents/MacOS/run
HERE="$(cd "$(dirname "$0")/../../.." && pwd)" || exit 1
cd "$HERE" || exit 1

# 로그인 셸을 거치지 않으므로 PATH 를 직접 채운다 (Homebrew · 공식 설치본 둘 다)
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

LOG="$HERE/설치기록.txt"

dialog() {
  /usr/bin/osascript -e "display dialog \"$1\" buttons {\"확인\"} default button 1 with title \"P2 DESK\" with icon caution" >/dev/null 2>&1
}
notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"P2 DESK\"" >/dev/null 2>&1
}

if ! command -v npm >/dev/null 2>&1; then
  dialog "Node.js 가 설치되어 있지 않습니다.\n\n잠시 후 열리는 nodejs.org 에서 왼쪽의 LTS 버튼을 눌러 설치한 뒤, 이 앱을 다시 실행해 주세요."
  /usr/bin/open "https://nodejs.org"
  exit 1
fi

# 앱 본체(약 100MB)가 없으면 받아온다. 한 번 받으면 다음부터는 건너뛴다.
if [ ! -d "node_modules/electron/dist" ]; then
  notify "필요한 파일을 내려받는 중입니다. 몇 분 걸립니다."
  : > "$LOG"
  npm install --foreground-scripts >>"$LOG" 2>&1

  # 첫 시도가 실패하면 다른 서버에서 한 번 더 (국내망에서 GitHub 가 막히는 경우)
  if [ ! -d "node_modules/electron/dist" ]; then
    notify "다른 서버에서 다시 시도합니다."
    {
      echo ""
      echo "=== 미러 서버로 재시도 ==="
    } >>"$LOG"
    rm -rf node_modules/electron
    ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/" \
      npm install electron --foreground-scripts >>"$LOG" 2>&1
  fi

  if [ ! -d "node_modules/electron/dist" ]; then
    dialog "필요한 파일을 내려받지 못했습니다.\n\n인터넷 연결을 확인해 주세요. 자세한 내용은 지금 열리는 설치기록.txt 에 있습니다."
    /usr/bin/open -t "$LOG" 2>/dev/null
    exit 1
  fi
  notify "준비가 끝났습니다. 앱을 엽니다."
fi

exec ./node_modules/.bin/electron .
