#!/bin/bash
#
# P2 DESK 설치파일(.dmg) 만들기 — macOS
#
# 바로실행기와 같은 이유로 터미널을 거치지 않는다. 여기서 만든 .dmg 를 설치하면
# Dock 과 Command+Tab 에 "Electron" 이 아니라 "P2 DESK" 로 제대로 나온다.
#
set -u

HERE="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)" || HERE=""
SETTINGS_DIR="$HOME/Library/Application Support/P2 DESK"
SAVED_PATH="$SETTINGS_DIR/project-path.txt"

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

looks_like_project() {
  [ -n "${1:-}" ] && [ -f "$1/package.json" ] && [ -d "$1/app" ] && [ -f "$1/electron/main.js" ]
}

resolve_project() {
  if looks_like_project "$HERE"; then echo "$HERE"; return 0; fi
  if [ -f "$SAVED_PATH" ]; then
    local saved
    saved="$(/bin/cat "$SAVED_PATH" 2>/dev/null)"
    if looks_like_project "$saved"; then echo "$saved"; return 0; fi
  fi
  local picked
  picked="$(/usr/bin/osascript -e 'POSIX path of (choose folder with prompt "압축을 푼 P2 DESK 폴더를 선택해 주세요")' 2>/dev/null)"
  picked="${picked%/}"
  if looks_like_project "$picked"; then
    /bin/mkdir -p "$SETTINGS_DIR"; /bin/echo "$picked" > "$SAVED_PATH"
    echo "$picked"; return 0
  fi
  return 1
}

PROJECT="$(resolve_project || true)"
if [ -z "${PROJECT:-}" ]; then
  /usr/bin/osascript -e 'display dialog "P2 DESK 폴더를 찾지 못했습니다." buttons {"확인"} default button 1 with title "P2 DESK" with icon caution' >/dev/null 2>&1
  exit 1
fi
cd "$PROJECT" || exit 1
LOG="$PROJECT/설치파일기록.txt"

if ! command -v npm >/dev/null 2>&1; then
  /usr/bin/osascript -e 'display dialog "Node.js 가 필요합니다. nodejs.org 에서 LTS 버전을 설치해 주세요." buttons {"확인"} default button 1 with title "P2 DESK" with icon caution' >/dev/null 2>&1
  /usr/bin/open "https://nodejs.org"; exit 1
fi

/usr/bin/osascript <<'APPLESCRIPT' >/dev/null 2>&1
display dialog "설치파일(.dmg)을 만듭니다.

5~10분 걸리고 그동안 화면에는 아무 변화가 없습니다.
다 되면 폴더가 저절로 열립니다.

이 창은 8초 뒤 닫힙니다." buttons {"확인"} default button 1 giving up after 8 with title "P2 DESK"
APPLESCRIPT

: > "$LOG" 2>/dev/null || true
[ -d "node_modules" ] || npm install --foreground-scripts >>"$LOG" 2>&1
[ -d "node_modules/electron/dist" ] || node scripts/ensure-electron.js >>"$LOG" 2>&1

npm run dist:mac >>"$LOG" 2>&1

DMG="$(/usr/bin/find "$PROJECT/release" -maxdepth 1 -name '*.dmg' 2>/dev/null | /usr/bin/head -1)"
if [ -n "$DMG" ]; then
  # 앱이 쓰고 있는 데이터 폴더(보통 클라우드 폴더)를 알아낸다.
  # 거기에 설치파일을 같이 두면 다른 컴퓨터에서 바로 받아 설치할 수 있다.
  CONFIG="$HOME/Library/Application Support/P2 DESK/assistant-config.json"
  CLOUD_DIR=""
  if [ -f "$CONFIG" ]; then
    CLOUD_DIR="$(/usr/bin/python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("dataDir",""))
except Exception:
    print("")' "$CONFIG" 2>/dev/null)"
  fi

  if [ -n "$CLOUD_DIR" ] && [ -d "$CLOUD_DIR" ]; then
    ANSWER="$(/usr/bin/osascript -e "display dialog \"설치파일이 만들어졌습니다.

이 파일을 데이터 폴더에 함께 넣어둘까요? 그러면 다른 컴퓨터(아이맥·새 PC)에서 따로 만들 필요 없이 바로 받아 설치할 수 있습니다.

넣을 곳: $CLOUD_DIR\" buttons {\"아니요\", \"넣어두기\"} default button 2 with title \"P2 DESK\"" 2>/dev/null)"
    if [ "${ANSWER:-}" = "button returned:넣어두기" ]; then
      /bin/mkdir -p "$CLOUD_DIR/설치파일"
      /bin/cp "$PROJECT/release/"*.dmg "$CLOUD_DIR/설치파일/" 2>/dev/null
      /bin/cp "$PROJECT/release/"*.exe "$CLOUD_DIR/설치파일/" 2>/dev/null
      /usr/bin/open "$CLOUD_DIR/설치파일"
      /usr/bin/osascript -e 'display dialog "넣어뒀습니다.

다른 컴퓨터에서는 같은 클라우드 폴더의 [설치파일] 안에서 .dmg 를 받아 설치하면 됩니다." buttons {"확인"} default button 1 with title "P2 DESK"' >/dev/null 2>&1
      exit 0
    fi
  fi

  /usr/bin/osascript -e 'display dialog "설치파일이 만들어졌습니다.

이제 열리는 폴더에서 .dmg 를 더블클릭하고, P2 DESK 를 응용 프로그램 폴더로 끌어다 놓으세요.

처음 열 때 경고가 뜨면 시스템 설정 → 개인정보 보호 및 보안 에서 [확인 없이 열기] 를 누르시면 됩니다." buttons {"확인"} default button 1 with title "P2 DESK"' >/dev/null 2>&1
  /usr/bin/open "$PROJECT/release"
  exit 0
fi

/usr/bin/osascript <<APPLESCRIPT >/dev/null 2>&1
set logTail to ""
try
  set logTail to (do shell script "tail -n 12 " & quoted form of "$LOG")
end try
display dialog "설치파일을 만들지 못했습니다." & return & return & ¬
  "아래 내용을 캡처해서 보내주세요." & return & return & logTail ¬
  buttons {"확인"} default button 1 with title "P2 DESK" with icon caution
APPLESCRIPT
exit 1
